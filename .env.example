# ==============================================================================
# TEMPLATE KONFIGURASI SUPABASE BACKEND - NEXUSS X TJKT 1
# ==============================================================================
# Salin file ini menjadi .env dan masukkan kredensial Supabase Anda:
# cp .env.example .env

# URL Project Supabase (Dapatkan dari Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (Aman digunakan di browser frontend dengan Row Level Security aktif)
# JANGAN PERNAH MENGGUNAKAN SERVICE_ROLE KEY DI SINI!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
